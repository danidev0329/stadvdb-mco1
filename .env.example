# MySQL connection (docker-compose maps container 3306 -> host 3307)
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3307
MYSQL_USER=root
MYSQL_PASSWORD=

# Optional: CA certificate path for cloud MySQL that requires TLS (e.g. Aiven)
# MYSQL_SSL_CA=/path/to/ca.pem

# Databases
SOURCE_DB=source_db
WAREHOUSE_DB=data_warehouse

# ETL tunables (safe defaults; override as needed)
ETL_CHUNK_SIZE=10000
ETL_BATCH_SIZE=5000

# dim_date generation range
DATE_START=2015-01-01
DATE_END=2026-12-31
